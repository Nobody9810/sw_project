[Unit]
Description=SW Project Next.js production server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sw_project/frontend
Environment=NODE_ENV=production
Environment=BACKEND_URL=http://127.0.0.1:8000
# Replace /usr/bin/node with the absolute path returned by `command -v node`.
ExecStart=/usr/bin/node /var/www/sw_project/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=10
TimeoutStopSec=90
UMask=0027

[Install]
WantedBy=multi-user.target
