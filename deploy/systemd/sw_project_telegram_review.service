[Unit]
Description=SW Project Telegram moderation receiver (single instance per bot)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sw_project/backend
Environment=DJANGO_ENV=production
Environment=PYTHONUNBUFFERED=1
# Stop the local receiver before enabling this unit for the same bot.
ExecStart=/var/www/sw_project/venv/bin/python manage.py run_telegram_moderator
Restart=always
RestartSec=10
TimeoutStopSec=90
UMask=0027

[Install]
WantedBy=multi-user.target
