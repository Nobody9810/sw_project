# Existing configuration names only. Never copy real credentials into this example.
# Django reads .env at the repository root. Leave your existing .env unchanged.
DJANGO_ENV=development
DEBUG=True
# Generate a unique value: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
MEDIA_FILE_HOSTS=
SUBMISSION_TRUSTED_PROXIES=
# Optional existing Redis cache; do not point test runs at production.
CACHE_URL=

# Backend-only Quran Foundation credentials. Never prefix these with NEXT_PUBLIC_.
QF_ENV=production
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_TRANSLATION_ID=

# Next.js reads these from frontend/.env.local or its deployment environment.
# Only copy the three non-secret frontend settings below to frontend/.env.local.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/api
# Production: use the public HTTPS origin so social platforms can fetch article previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stage 2 authentication (server-only credentials; do not paste them into source).
PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Overseas SMTP service, with a verified sender domain.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Seconds per SMTP attempt in the outbox worker (manage.py run_outbound_worker).
EMAIL_TIMEOUT=15

# Stage 3: backend-only Telegram moderation reminders (same outbox worker).
# Both values are required to enable reminders. Never use NEXT_PUBLIC_ for these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public article publishing: create a separate bot and grant it channel posting rights.
# Public channel can use @channel_username; private channel uses its -100... ID.
TELEGRAM_PUBLISH_BOT_TOKEN=
TELEGRAM_PUBLISH_CHANNEL_ID=
# Optional: comma-separated Telegram USER IDs allowed to review (not Django account IDs).
# Empty: only the owner of the configured private chat can review. Required for groups.
TELEGRAM_REVIEWER_IDS=
