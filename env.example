# =========================================
# Django 环境配置
# =========================================
# 运行环境: development 或 production
DJANGO_ENV=development

# =========================================
# 安全配置
# =========================================
# Django Secret Key (生产环境必须设置，使用强随机字符串)
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-102a$v)!_9vtve+1y)(ojiwf23j&nm2&qejnzicp8m(epjnedu

# 调试模式 (生产环境必须设置为 False)
DEBUG=True

# 允许的主机 (生产环境必须设置，多个用逗号分隔)
# 例如: ALLOWED_HOSTS=example.com,www.example.com,192.168.1.100
ALLOWED_HOSTS=*

# CSRF 信任的源 (生产环境必须设置，多个用逗号分隔)
# 例如: CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =========================================
# 数据库配置
# =========================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=shuwei
DB_USER=root
DB_PASSWORD=112233
DB_HOST=localhost
DB_PORT=3306

# =========================================
# 邮件配置 (可选)
# =========================================
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
